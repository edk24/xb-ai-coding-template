{
  "name": "admin-monorepo-template",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:admin": "pnpm --filter admin dev",
    "build:admin": "pnpm --filter admin build",
    "preview:admin": "pnpm --filter admin preview",
    "api:up": "docker compose up -d api mysql",
    "api:down": "docker compose down",
    "api:logs": "docker compose logs -f api",
    "api:install": "docker compose run --rm composer install --working-dir=apps/api",
    "lint": "pnpm --filter admin lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
