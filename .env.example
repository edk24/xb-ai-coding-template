# Docker Compose 环境变量模板
# 用法：cp .env.example .env && 按注释填写真实值（.env 已被 .gitignore 忽略）
# 注意：敏感值在 docker-compose.yml 中均无默认值，缺失时 compose 会直接报错并提示变量名。

# ===== MySQL =====
# MySQL root 密码（必填，仅用于容器初始化/运维）
MYSQL_ROOT_PASSWORD=change-me-root-password
# 业务库名
MYSQL_DATABASE=admin_system
# 业务账号
MYSQL_USER=admin
# 业务账号密码（必填）
MYSQL_PASSWORD=change-me-app-password
# 宿主端口，仅绑定 127.0.0.1
MYSQL_PORT=3309

# ===== API =====
# 数据库密码（必填，与 MYSQL_PASSWORD 保持一致）
SPRING_DATASOURCE_PASSWORD=change-me-app-password
# JWT 签名密钥（必填，≥32 字符；生成方式：openssl rand -hex 32）
# 应用启动时会强校验，使用默认值或长度不足会直接启动失败，因此这里故意使用短占位值
JWT_SECRET=CHANGE_ME
# JWT 有效期（秒）
JWT_EXPIRE_SECONDS=7200
# API 镜像 tag（用于区分本地/环境构建产物）
API_IMAGE_TAG=local
# Spring profile（仓库未提供 application-local.yml 时使用默认配置即可）
SPRING_PROFILES_ACTIVE=local
