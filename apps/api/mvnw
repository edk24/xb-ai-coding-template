#!/usr/bin/env sh
set -eu

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Neither mvn nor docker is available. Install Maven/JDK 21 or Docker." >&2
  exit 127
fi

exec docker run --rm \
  -v "$PWD":/workspace \
  -v "$HOME/.m2":/root/.m2 \
  -w /workspace \
  maven:3.9.9-eclipse-temurin-21 \
  mvn "$@"
